{
  "uid": "hh-pipeline-health",
  "title": "HH ETL — здоровье пайплайна",
  "tags": ["hh", "etl", "observability"],
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Последний прогон hh_etl",
      "description": "NULLS LAST обязателен: в Postgres NULL при DESC идёт ПЕРВЫМ, а у прогона в состоянии queued start_date ещё NULL — панель показывала очередь вместо последнего фактического результата и прятала предыдущий провал.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "hh_postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "hh_postgres" },
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT state FROM dag_run WHERE dag_id='hh_etl' ORDER BY start_date DESC NULLS LAST LIMIT 1"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/", "values": true },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "success": { "color": "green", "index": 0 }, "failed": { "color": "red", "index": 1 }, "running": { "color": "blue", "index": 2 }, "queued": { "color": "yellow", "index": 3 } } }
          ],
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Успешных прогонов (7 дней)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "hh_postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "hh_postgres" },
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE state='success') AS ok, count(*) AS total FROM dag_run WHERE dag_id='hh_etl' AND start_date > now() - interval '7 days'"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Длительность задач по времени (сек)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "hh_postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "hh_postgres" },
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT start_date AS time, task_id AS metric, duration AS value FROM task_instance WHERE dag_id='hh_etl' AND duration IS NOT NULL AND $__timeFilter(start_date) ORDER BY start_date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "pointSize": 6, "showPoints": "always", "fillOpacity": 10 },
          "unit": "s",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Последние прогоны hh_etl",
      "description": "NULLS LAST по той же причине, что и в панели «Последний прогон»: queued-прогон с пустым start_date иначе всплывал наверх таблицы.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "hh_postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "hh_postgres" },
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT start_date AS \"начало\", run_type AS \"тип\", state AS \"статус\", round(EXTRACT(EPOCH FROM (end_date - start_date))::numeric, 1) AS \"сек\" FROM dag_run WHERE dag_id='hh_etl' ORDER BY start_date DESC NULLS LAST LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "статус" }, "properties": [ { "id": "mappings", "value": [ { "type": "value", "options": { "success": { "color": "green", "index": 0 }, "failed": { "color": "red", "index": 1 } } } ] }, { "id": "custom.cellOptions", "value": { "type": "color-text" } } ] }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Строк в core.vacancies",
      "description": "Результат заливки, а не состояние прогона. LOAD_SQL начинается с TRUNCATE core.vacancy_skills, core.vacancies, а Pipeline.load печатает loaded: N и никак N не проверяет — нулевой срез заменял витрину и рапортовал success. Порог: 0 — красный, меньше 50 000 — оранжевый (ожидаемый объём кеша ~92 700).",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 9 },
      "datasource": { "type": "postgres", "uid": "hh_dwh" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "hh_dwh" },
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS \"строк\" FROM core.vacancies"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 50000 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Свежесть: залито за 24 ч",
      "description": "core.vacancies.loaded_at ставится DEFAULT now() на каждой перезаливке, поэтому ноль здесь означает «за сутки заливки не было» — ровно тот случай, когда шаг `python -m etl all` молча срезается лимитом ExecutionTimeLimit крон-задачи, а панели прогонов остаются зелёными.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 9 },
      "datasource": { "type": "postgres", "uid": "hh_dwh" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "hh_dwh" },
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS \"за 24 ч\" FROM core.vacancies WHERE loaded_at > now() - interval '24 hours'"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 50000 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Логи по уровням во времени (count / интервал)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (level) (count_over_time({project=\"hh-dwh\"}[$__interval]))",
          "legendFormat": "{{level}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 70, "lineWidth": 1 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "WARN" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "WARNING" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "INFO" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "LOG" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Логи стека (Loki)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{project=\"hh-dwh\"}"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "dedupStrategy": "none", "sortOrder": "Descending" }
    }
  ]
}
