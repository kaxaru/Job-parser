{# ── Общая тема ленты и дашборда ─────────────────────────────────────────────────────────
   Токены палитры, сброс, видимый фокус, анимация смены темы и переключатель `#theme-toggle`
   лежали двумя копиями в `feed.css.j2` и `dashboard.css.j2` и расходились молча: правку
   вносили в один экран, второй продолжал жить со старым значением (аудит 2026-09-22, §3.3).
   Файл — Jinja-шаблон, потому что палитра приходит из Python (`config.py::BG/PAPER/...`).
   Различия экранов остались на месте: заливки карточек, шкала размеров и радиус пилюли
   нужны только ленте (`feed.css.j2`), кнопку темы лента несёт вместе с `.hdr-btn`, а у
   дашборда кнопка держится правой кромки шапки. #}

/* Токены темы. Палитра приходит из Python (config.py::BG/PAPER/GRID/TEXT/ACCENT) — здесь она
   один раз кладётся в переменные, чтобы дальше не было россыпи хардкод-серых (их было
   девять: #444…#ddd) и чтобы оба экрана опирались на одни и те же имена.
   Приглушённые тона подобраны по контрасту, а не на глаз: #868686 даёт 4.62:1 на карточке,
   #7C7C7C — 4.52:1 на фоне; прежние #666/#444 давали 2.93:1 и 1.94:1 (ниже нормы AA). */
:root {
  color-scheme: dark;              /* нативные списки (datalist города), скроллбары, календари */
  --bg: {{ bg }};
  --paper: {{ paper }};
  --grid: {{ grid }};
  --text: {{ text }};
  --accent: {{ accent }};
  --title: #fff;                   /* заголовки: в тёмной теме белые, в светлой почти чёрные */
  --muted: #868686;                /* второстепенный текст на карточке (4.62:1) */
  --muted-strong: #a9a9a9;         /* подписи, которые должны читаться легко */
}

/* Светлая тема. Не инверсия тёмной, а отдельно подобранный набор: приглушённые тона
   пересчитаны под белую подложку (#767676 даёт 4.54:1 на карточке, #707070 — на фоне),
   акцент оставлен тот же — он проходит и как текст (4.61:1), и как заливка под белым.
   Заливки бейджей НЕ меняются: они самодостаточные плашки, белый текст на них читается
   в обеих темах. На светлом карточку отделяет не рамка (1.3:1), а мягкая тень. */
:root[data-theme="light"] {
  color-scheme: light;
  --bg: #F4F5F7;
  --paper: #FFFFFF;
  --grid: #DDE1E7;
  --text: #1B1F27;
  --title: #0E1116;
  --muted: #767676;
  --muted-strong: #5D6470;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--text);
  /* системный стек вместо Arial: родные метрики Windows/mac, цифры не пляшут по ширине */
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  font-variant-numeric: tabular-nums;   /* зарплаты и проценты выравниваются в колонку */
  min-height: 100vh;
}

/* Видимый фокус для всего интерактивного: раньше он был только у пилюль-чекбоксов,
   остальные элементы полагались на браузерный дефолт, невидимый на тёмном фоне. */
:where(button, a, input, select, textarea, [tabindex]):focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

/* ── Анимация смены темы ──
   Основной эффект — круговой раскрыв новой темы из кнопки-переключателя (View Transitions).
   Штатные анимации снимка глушим: движение задаёт clip-path из JS, иначе поверх нашего
   раскрытия наложится браузерное растворение и получится каша. */
::view-transition-old(root),
::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
::view-transition-old(root) { z-index: 1; }
::view-transition-new(root) { z-index: 2; }

/* Во время View-перехода собственные transition элементов ГЛУШИМ. Иначе они стартуют внутри
   замороженного снимка и после перехода остаются со старым значением: у вкладки, активной
   на момент переключения, --title/--bg уже светлые, а вычисленные color/background — ещё
   тёмные (белым по белому). Проверено A/B: без View Transitions бага нет. Движение перехода
   даёт clip-path, поэтому терять здесь нечего. */
:root.theme-swap,
:root.theme-swap *,
:root.theme-swap *::before,
:root.theme-swap *::after { transition: none !important; }

/* Фолбэк для браузеров без View Transitions: плавно переливаем сами цвета. Класс висит
   только на время перехода — постоянные transition на всех узлах тормозили бы ленту
   и мешали собственным анимациям ховеров. */
:root.theme-anim,
:root.theme-anim *,
:root.theme-anim *::before,
:root.theme-anim *::after {
  transition: background-color .32s ease, color .32s ease, border-color .32s ease,
              box-shadow .32s ease, fill .32s ease, stroke .32s ease !important;
}

/* Переключатель темы: две иконки лежат друг на друге и меняются поворотом с растворением —
   солнце уезжает вправо-вниз, луна приходит на его место. Показывается ТЕКУЩАЯ тема
   (луна = сейчас тёмная), поэтому подпись у кнопки говорит, что произойдёт по клику.
   Высоту дашборд перебивает своей (30px против 28px), а лента — габаритами `.hdr-btn`,
   поэтому разметка кнопки вынесена в `theme-toggle.html.j2`, а не собрана здесь. */
.theme-toggle {
  position: relative;
  width: 34px;
  height: 28px;
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1px solid var(--grid);
  border-radius: 6px;
  color: var(--muted-strong);
  cursor: pointer;
  overflow: hidden;
  transition: border-color .12s, color .12s;
}
.theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
.theme-toggle svg {
  position: absolute;
  width: 16px;
  height: 16px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  transition: transform .38s cubic-bezier(.34, 1.3, .5, 1), opacity .22s ease;
}
.theme-toggle .i-sun  { opacity: 0; transform: rotate(-120deg) scale(.35); }
.theme-toggle .i-moon { opacity: 1; transform: rotate(0) scale(1); }
:root[data-theme="light"] .theme-toggle .i-sun  { opacity: 1; transform: rotate(0) scale(1); }
:root[data-theme="light"] .theme-toggle .i-moon { opacity: 0; transform: rotate(120deg) scale(.35); }
