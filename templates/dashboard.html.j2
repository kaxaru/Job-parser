<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<title>HR Market Dashboard — Программисты РФ</title>
<link rel="stylesheet" href="dashboard.css">
<!-- Тема до отрисовки, чтобы страница не мигнула тёмной; ключ общий с лентой -->
<script>try{if(localStorage.getItem('feed.theme')==='light'){document.documentElement.dataset.theme='light';}}catch(e){}</script>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
</head>
<body>
<header>
  <div>
    <h1>HR Market Dashboard &mdash; Рынок труда программистов РФ</h1>
    <p>Данные: hh.ru &nbsp;|&nbsp; {{ total_vacancies }} вакансий &nbsp;|&nbsp; {{ total_cities }} городов &nbsp;|&nbsp; {{ year }}</p>
  </div>
  <button id="theme-toggle" class="theme-toggle" type="button"
          title="Переключить тему" aria-label="Включить светлую тему">
    <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/>
    </svg>
    <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2"/>
      <path d="M12 2.6v2.2M12 19.2v2.2M4.4 12H2.2M21.8 12h-2.2
               M6.3 6.3 4.8 4.8M19.2 19.2l-1.5-1.5M17.7 6.3l1.5-1.5M4.8 19.2l1.5-1.5"/>
    </svg>
  </button>
</header>

{% if sources|length > 1 %}
<nav class="src-tabs">
  <span class="src-label">Источник:</span>
  {% for s in sources %}
  <button class="src-btn" id="src-{{ s }}" onclick="showSource('{{ s }}')">{{ source_labels[s] }}</button>
  {% endfor %}
</nav>
{% endif %}

<nav class="tabs">
  {% for k in keys %}
  <button class="tab-btn" id="btn-{{ k }}" onclick="showTab('{{ k }}')">{{ labels[k] }}</button>
  {% endfor %}
</nav>

<div class="content">
  {% for s in sources %}
  {% for k in keys %}
  {% if variants[s][k] %}
  <div class="tab-pane" id="pane-{{ s }}-{{ k }}" data-src="{{ s }}" data-key="{{ k }}">{{ variants[s][k] }}</div>
  {% endif %}
  {% endfor %}
  {% endfor %}
</div>

<script src="dashboard.js"></script>
<script>initDashboard('{{ first_source }}', '{{ first_key }}');</script>
</body>
</html>
