/* Токены темы. Палитра приходит из Python (config.py::BG/PAPER/GRID/TEXT/ACCENT) — здесь она
   один раз кладётся в переменные, чтобы дальше в файле не было россыпи хардкод-серых
   (их было девять: #444…#ddd) и чтобы дашборд мог опираться на те же имена.
   Приглушённые тона подобраны по контрасту, а не на глаз: #868686 даёт 4.62:1 на карточке,
   #7C7C7C — 4.52:1 на фоне; прежние #666/#444 давали 2.93:1 и 1.94:1 (ниже нормы AA). */
:root {
  color-scheme: dark;              /* нативные списки (datalist города), скроллбары, календари */
  --bg: {{ bg }};
  --paper: {{ paper }};
  --grid: {{ grid }};
  --text: {{ text }};
  --accent: {{ accent }};
  --title: #fff;                   /* заголовки: в тёмной теме белые, в светлой почти чёрные */
  --muted: #868686;                /* второстепенный текст на карточке (4.62:1) */
  --muted-strong: #a9a9a9;         /* подписи, которые должны читаться легко */
  --muted-on-bg: #7C7C7C;          /* то же, но на тёмном фоне страницы (4.52:1) */
  --ink: #0b0d12;                  /* тёмный текст поверх светлых плашек */
  --tint-applied: #15241b;         /* заливка карточки по состоянию отклика */
  --tint-rejected: #251618;
  --tint-botiv: #241f10;
  --tint-frozen: #16202a;
  --card-shadow: none;             /* на тёмном карточки отделяет рамка, тень не нужна */
  --fs-xs: 0.72rem;
  --fs-sm: 0.8rem;
  --fs-md: 0.88rem;
  --fs-lg: 1rem;
  --fs-xl: 1.3rem;
  --radius: 8px;
  --radius-pill: 999px;
}

/* Светлая тема. Не инверсия тёмной, а отдельно подобранный набор: приглушённые тона
   пересчитаны под белую подложку (#767676 даёт 4.54:1 на карточке, #707070 — на фоне),
   акцент оставлен тот же — он проходит и как текст (4.61:1), и как заливка под белым.
   Заливки бейджей НЕ меняются: они самодостаточные плашки, белый текст на них читается
   в обеих темах. На светлом карточку отделяет не рамка (1.3:1), а мягкая тень. */
:root[data-theme="light"] {
  color-scheme: light;
  --bg: #F4F5F7;
  --paper: #FFFFFF;
  --grid: #DDE1E7;
  --text: #1B1F27;
  --title: #0E1116;
  --muted: #767676;
  --muted-strong: #5D6470;
  --muted-on-bg: #707070;
  --ink: #0b0d12;
  --tint-applied: #E9F6EE;
  --tint-rejected: #FDECEC;
  --tint-botiv: #FBF3DC;
  --tint-frozen: #EAF2F8;
  --card-shadow: 0 1px 2px rgba(16, 24, 40, .07), 0 1px 3px rgba(16, 24, 40, .05);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--text);
  /* системный стек вместо Arial: родные метрики Windows/mac, цифры не пляшут по ширине */
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  font-variant-numeric: tabular-nums;   /* зарплаты и проценты выравниваются в колонку */
  min-height: 100vh;
}

/* Видимый фокус для всего интерактивного: раньше он был только у пилюль-чекбоксов,
   остальные элементы полагались на браузерный дефолт, невидимый на тёмном фоне. */
:where(button, a, input, select, textarea, [tabindex]):focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

/* ── Анимация смены темы ──
   Основной эффект — круговой раскрыв новой темы из кнопки-переключателя (View Transitions).
   Штатные анимации снимка глушим: движение задаёт clip-path из JS, иначе поверх нашего
   раскрытия наложится браузерное растворение и получится каша. */
::view-transition-old(root),
::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
::view-transition-old(root) { z-index: 1; }
::view-transition-new(root) { z-index: 2; }

/* Во время View-перехода собственные transition элементов ГЛУШИМ. Иначе они стартуют внутри
   замороженного снимка и после перехода остаются со старым значением: у вкладки, активной
   на момент переключения, --title/--bg уже светлые, а вычисленные color/background — ещё
   тёмные (белым по белому). Проверено A/B: без View Transitions бага нет. Движение перехода
   даёт clip-path, поэтому терять здесь нечего. */
:root.theme-swap,
:root.theme-swap *,
:root.theme-swap *::before,
:root.theme-swap *::after { transition: none !important; }

/* Фолбэк для браузеров без View Transitions: плавно переливаем сами цвета. Класс висит
   только на время перехода — постоянные transition на всех узлах тормозили бы ленту
   и мешали собственным анимациям ховеров. */
:root.theme-anim,
:root.theme-anim *,
:root.theme-anim *::before,
:root.theme-anim *::after {
  transition: background-color .32s ease, color .32s ease, border-color .32s ease,
              box-shadow .32s ease, fill .32s ease, stroke .32s ease !important;
}
header {
  background: var(--paper);
  padding: 16px 24px;
  border-bottom: 1px solid var(--grid);
  display: flex;
  align-items: baseline;
  gap: 16px;
  flex-wrap: wrap;
}
header h1 { font-size: var(--fs-xl); color: var(--title); }
#counter { font-size: 0.85rem; color: var(--muted); }

/* Экспорт/импорт отметок + индикатор синхронизации */
.hdr-actions { margin-left: auto; display: flex; align-items: center; gap: 10px; }
.hdr-btn {
  display: inline-flex;
  align-items: center;
  background: transparent;
  border: 1px solid var(--grid);
  color: var(--muted-strong);
  padding: 4px 11px;
  border-radius: 6px;
  font-size: 0.78rem;
  cursor: pointer;
  transition: border-color .12s, color .12s;
}
.hdr-btn:hover { border-color: var(--accent); color: var(--accent); }

/* Переключатель темы: две иконки лежат друг на друге и меняются поворотом с растворением —
   солнце уезжает вправо-вниз, луна приходит на его место. Показывается ТЕКУЩАЯ тема
   (луна = сейчас тёмная), поэтому подпись у кнопки говорит, что произойдёт по клику. */
.theme-toggle {
  position: relative;
  width: 34px;
  height: 28px;
  padding: 0;
  justify-content: center;
  overflow: hidden;
}
.theme-toggle svg {
  position: absolute;
  width: 16px;
  height: 16px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  transition: transform .38s cubic-bezier(.34, 1.3, .5, 1), opacity .22s ease;
}
.theme-toggle .i-sun  { opacity: 0; transform: rotate(-120deg) scale(.35); }
.theme-toggle .i-moon { opacity: 1; transform: rotate(0) scale(1); }
:root[data-theme="light"] .theme-toggle .i-sun  { opacity: 1; transform: rotate(0) scale(1); }
:root[data-theme="light"] .theme-toggle .i-moon { opacity: 0; transform: rotate(120deg) scale(.35); }
.sync-status { font-size: 0.74rem; color: var(--muted); white-space: nowrap; }
.sync-status.ok    { color: #3fae6b; }
.sync-status.busy  { color: var(--accent); }
.sync-status.err   { color: #d35a5a; }
.sync-status.local { color: #c79a3a; }

/* ── Панель управления ────────────────────────────────
   Липкой оставлена только узкая полоса (~48px). Раньше липким был весь бар с фильтрами:
   замерено 398px при окне 1000px — 40% экрана постоянно, а на ширине 900px 691px из 900,
   то есть 77%, и до карточек надо было доскроллить. Сами группы фильтров теперь
   раскрываются под полосой и НЕ липкие. */
.filter-toolbar {
  position: sticky;
  top: 0;
  z-index: 101;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding: 8px 24px;
  background: var(--paper);
  border-bottom: 1px solid var(--grid);
}
.toolbar-toggle {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: transparent;
  border: 1px solid var(--grid);
  color: var(--text);
  padding: 5px 13px;
  border-radius: 6px;
  font-size: var(--fs-sm);
  cursor: pointer;
  transition: border-color .12s, color .12s;
}
.toolbar-toggle:hover { border-color: var(--accent); color: var(--accent); }
.toolbar-toggle[aria-expanded="true"] { border-color: var(--accent); }
.toolbar-toggle .chev { transition: transform .15s; }
.toolbar-toggle[aria-expanded="true"] .chev { transform: rotate(180deg); }
/* Счётчик активных фильтров: свёрнутая панель не должна скрывать, что выдача урезана */
.filters-count {
  background: var(--accent);
  color: #fff;
  border-radius: var(--radius-pill);
  padding: 0 7px;
  font-size: var(--fs-xs);
  font-weight: 700;
}
.filters-count[hidden] { display: none; }
.toolbar-spacer { margin-left: auto; }

.filter-bar {
  background: var(--paper);
  border-bottom: 2px solid var(--grid);
  padding: 12px 24px;
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  align-items: flex-start;
}
/* [hidden] не сработал бы сам: display:flex выше специфичнее UA-стиля */
.filter-bar[hidden] { display: none; }
.filter-group { display: flex; flex-direction: column; gap: 6px; }
.filter-label {
  font-size: 0.72rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* Поиск по названию */
.search-wrap { min-width: 240px; }
.search-input {
  width: 260px;
  max-width: 100%;
  background: var(--grid);
  color: var(--text);
  border: 1px solid var(--grid);
  border-radius: 6px;
  padding: 6px 11px;
  font-size: 0.85rem;
}
.search-input:focus { outline: none; border-color: var(--accent); }
.search-input::placeholder { color: var(--muted); }
/* Город: тот же инпут, но узкий как прежний select (input+datalist = список с поиском) */
.city-input { width: 180px; }

/* Пилюли-чекбоксы (языки / роли / опыт).
   Скрываем и красим ПО МЕСТУ (`.lang-grid input[type=checkbox]`), а не по списку классов:
   у ролей класс `role-cb`, и когда правило перечисляло только `.lang-cb`, в группе «Роль»
   торчали нативные чекбоксы, а пилюля не подсвечивалась при выборе. Новая группа получит
   оформление сама. Классы в разметке остаются — по ним JS различает группы
   (`.lang-cb:not(.exp-cb)` = языки), поэтому склеивать их в один нельзя. */
.lang-grid { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; }
/* Не `display:none`: скрытый так чекбокс теряет фокус, и клавиатурная навигация по пилюлям
   ломается. Выводим из потока, оставляя фокусируемым. */
.lang-grid input[type=checkbox] {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}
.lang-label {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 12px;
  border: 1px solid var(--grid);
  cursor: pointer;
  font-size: 0.78rem;
  background: transparent;
  color: var(--text);
  transition: background .12s, border-color .12s, color .12s, box-shadow .12s;
  user-select: none;
}
.lang-label:hover { border-color: var(--accent); color: var(--accent); }
.lang-label:active { transform: translateY(1px); }
.lang-grid input[type=checkbox]:checked + .lang-label {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 27%, transparent);
}
.lang-grid input[type=checkbox]:checked + .lang-label:hover {
  color: #fff;                                  /* выбранная пилюля не «выцветает» на ховере */
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 33%, transparent);
}
/* Клавиатура: пилюля должна показывать фокус, раз сам чекбокс невидим */
.lang-grid input[type=checkbox]:focus-visible + .lang-label {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
}

/* Salary range */
.salary-wrap { display: flex; flex-direction: column; gap: 5px; min-width: 220px; }
.salary-row  { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; }
.salary-row span.lbl { color: var(--muted); width: 18px; }
input[type=range] { width: 160px; accent-color: var(--accent); cursor: pointer; }
.sal-val { min-width: 56px; color: var(--accent); font-size: 0.8rem; }

/* City dropdown */
select {
  background: var(--grid);
  color: var(--text);
  border: 1px solid var(--grid);
  border-radius: 4px;
  padding: 5px 8px;
  font-size: 0.85rem;
  cursor: pointer;
  max-width: 180px;
}
select option { background: var(--paper); }

/* Schedule toggle */
.sched-btns {
  display: flex;
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid var(--grid);
}
.sched-btn {
  background: transparent;
  border: none;
  color: var(--muted);
  padding: 5px 13px;
  cursor: pointer;
  font-size: 0.78rem;
  transition: background .12s, color .12s;
}
.sched-btn + .sched-btn { border-left: 1px solid var(--grid); }
.sched-btn:hover { background: var(--grid); color: var(--text); }
.sched-btn.active { background: var(--accent); color: #fff; }

/* Календарь «Мои отклики»: date-инпуты внутри .sched-btns */
.date-input {
  background: transparent;
  border: none;
  border-left: 1px solid var(--grid);
  color: var(--text);
  padding: 4px 8px;
  font-size: 0.76rem;
  cursor: pointer;
}
.date-dash { color: var(--muted); align-self: center; padding: 0 2px; }

/* Reset */
.reset-btn {
  background: transparent;
  border: 1px solid var(--grid);
  color: var(--muted);
  padding: 5px 13px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 0.78rem;
  align-self: flex-end;
  transition: border-color .12s, color .12s;
}
.reset-btn:hover { border-color: var(--accent); color: var(--accent); }

/* ── Cards ────────────────────────────────────────── */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 14px;
  padding: 20px 24px 40px;
}
.card {
  background: var(--paper);
  border: 1px solid var(--grid);
  border-radius: 8px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  box-shadow: var(--card-shadow);
  transition: border-color .15s, box-shadow .15s;
  cursor: pointer;
}
.card:hover { border-color: var(--accent); box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 13%, transparent); }
.card:focus-visible { border-color: var(--accent); }
.tags { display: flex; flex-wrap: wrap; gap: 5px; min-height: 22px; }
/* Теги — контурные, а не заливные. Заливка делала их самым ярким пятном карточки: цветной
   ряд технологий перекрикивал заголовок вакансии, то есть самое важное проигрывало
   второстепенному. Цвет технологии сохранён в рамке и тексте, вес — снижен. */
.tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 0.7rem;
  font-weight: 600;
  white-space: nowrap;
  background: transparent;
  border: 1px solid currentColor;       /* цвет тона приходит инлайном (model.js::tagInk) */
  opacity: .9;
}
.card:hover .tag { opacity: 1; }
.card-title {
  color: var(--title);
  text-decoration: none;
  font-size: var(--fs-lg);
  font-weight: 700;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  position: relative;
  z-index: 1;        /* sits above card click area so link still works */
}
.card-title:hover { color: var(--accent); }
.card-sub { font-size: 0.78rem; color: var(--muted); }
.card-sal {
  font-size: 0.8rem;
  color: var(--muted-strong);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

/* Панель статусов под карточкой. margin-top:auto прижимает её к низу: содержимое карточек
   разной длины (0–2 ряда тегов, есть/нет зарплаты) разносило кнопки по вертикали на 35px
   внутри одного ряда сетки — замерено на живой странице. */
.card-foot { display: flex; gap: 8px; margin-top: auto; padding-top: 2px; }

/* Тогглы «откликнулся» (зелёный) / «отказ» (красный) */
.status-btn {
  flex: 1;
  background: transparent;
  border: 1px solid var(--grid);
  color: var(--muted);
  padding: 3px 9px;
  border-radius: 6px;
  font-size: 0.72rem;
  cursor: pointer;
  white-space: nowrap;
  transition: background .12s, border-color .12s, color .12s;
}
.status-btn.st-applied-btn:hover   { border-color: #3fae6b; color: #3fae6b; }
.status-btn.st-applied-btn.active  { background: #2e7d46; border-color: #2e7d46; color: #fff; }
.status-btn.st-rejected-btn:hover  { border-color: #d35a5a; color: #d35a5a; }
.status-btn.st-rejected-btn.active { background: #a33b3b; border-color: #a33b3b; color: #fff; }

/* Статусы карточки: зелёная (откликнулся) / красная (отказ — будет позже) */
.card.st-applied  { border-color: #2e7d46; background: var(--tint-applied); }
.card.st-applied:hover  { border-color: #3fae6b; box-shadow: 0 0 0 1px #3fae6b55; }
.card.st-rejected { border-color: #a33b3b; background: var(--tint-rejected); }
.card.st-rejected:hover { border-color: #d35a5a; box-shadow: 0 0 0 1px #d35a5a55; }

/* Бот-интервью в чужом мессенджере (полумёртвое): жёлтая рамка вместо зелёной «откликнулся» —
   отклик формально есть, но вакансия почти всегда морозится. Уступает отказу/приглашению
   с HH: они — реальный исход, а это лишь предупреждение (model.js::cardTone). */
.card.st-botiv { border-color: #b8930f; background: var(--tint-botiv); }
.card.st-botiv:hover { border-color: #E8C11C; box-shadow: 0 0 0 1px #E8C11C55; }

/* Протухшая форма (form_dead): вакансию сняли с публикации — «фриз». Синяя рамка, а не
   красная: это не отказ работодателя, а истёкшая вакансия, и она вернётся в оборот сама,
   если HH её переопубликует (form_status.py::skippable_form_ids).
   grayscale убран намеренно: фильтр выцветал бы и саму синюю рамку. */
.card.st-frozen { border-color: #4A7B9A; background: var(--tint-frozen); }
.card.st-frozen:hover { border-color: #6BA3C4; box-shadow: 0 0 0 1px color-mix(in srgb, #6BA3C4 33%, transparent); }
.card.st-dead { opacity: .72; }
.card.st-dead:hover { opacity: 1; }

/* Совпадение с резюме: цвет от тёплого (100%) к холодному (0%) задаётся inline. */
.match-badge {
  flex-shrink: 0;
  padding: 2px 9px;
  border-radius: 999px;
  color: #fff;
  font-size: 0.74rem;
  font-weight: 700;
  line-height: 1.6;
  white-space: nowrap;
  text-shadow: 0 1px 1px rgba(0,0,0,.35);
  cursor: help;
}
.card-status { display: flex; flex-wrap: wrap; gap: 5px; margin: 2px 0; }
.card-status:empty { display: none; }
.status-badge {
  padding: 1px 8px;
  border-radius: 999px;
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  line-height: 1.7;
  white-space: nowrap;
  text-shadow: 0 1px 1px rgba(0,0,0,.35);
  cursor: help;
}
/* Первая отрисовка: feed-data.js весит ~50 МБ, и пока браузер его парсит, сетка пуста —
   раньше это выглядело как зависшая страница. :empty снимает заглушку сам, как только
   вставлена первая карточка (или .no-results), без единой строки JS. */
.cards-grid:empty {
  min-height: 40vh;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--muted-on-bg);
  font-size: var(--fs-md);
}
.cards-grid:empty::before {
  content: '';
  width: 16px; height: 16px;
  border: 2px solid var(--grid);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin .7s linear infinite;
}
.cards-grid:empty::after { content: 'Загружаем вакансии…'; }

.no-results {
  grid-column: 1 / -1;
  text-align: center;
  color: var(--muted-on-bg);
  padding: 80px 0;
  font-size: 1.1rem;
}

/* ── Modal ────────────────────────────────────────── */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.72);
  z-index: 200;
  align-items: center;
  justify-content: center;
  padding: 16px;
  backdrop-filter: blur(2px);
}
.modal-overlay.open { display: flex; }

.modal-box {
  background: var(--paper);
  border: 1px solid var(--grid);
  border-radius: 12px;
  width: 100%;
  max-width: 700px;
  max-height: 88vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  animation: modal-in .15s ease;
}
@keyframes modal-in {
  from { opacity: 0; transform: translateY(12px) scale(.98); }
  to   { opacity: 1; transform: none; }
}

.modal-head {
  padding: 20px 24px 18px;
  border-bottom: 1px solid var(--grid);
  position: relative;
}
.modal-close {
  position: absolute;
  top: 14px;
  right: 16px;
  background: transparent;
  border: 1px solid var(--grid);
  color: var(--muted);
  font-size: 1.2rem;
  line-height: 1;
  width: 28px;
  height: 28px;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color .12s, color .12s;
}
.modal-close:hover { border-color: #e05; color: #e05; }

.modal-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 12px; padding-right: 36px; }
.modal-title {
  color: var(--title);
  text-decoration: none;
  font-size: 1.15rem;
  font-weight: 700;
  line-height: 1.35;
  display: block;
  margin-bottom: 8px;
}
.modal-title:hover { color: var(--accent); }
.modal-meta { font-size: 0.82rem; color: var(--muted); margin-bottom: 4px; }
.modal-sal  {
  font-size: 0.9rem;
  color: var(--muted-strong);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.modal-body { padding: 20px 24px; }

/* ── Сопроводительное письмо ──────────────────────── */
.cover {
  background: var(--bg);
  border: 1px solid var(--grid);
  border-radius: 8px;
  padding: 12px 14px;
  margin-bottom: 18px;
}
.cover-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}
.cover-title { font-size: 0.85rem; font-weight: 700; color: var(--title); }
.cover-actions { display: flex; gap: 6px; }
.cover-btn {
  background: transparent;
  border: 1px solid var(--grid);
  color: var(--muted-strong);
  padding: 4px 10px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.75rem;
  transition: border-color .12s, color .12s, opacity .12s;
}
.cover-btn:hover { border-color: var(--accent); color: var(--accent); }
.cover-copy { background: var(--accent); border-color: var(--accent); color: #fff; }
.cover-copy:hover { color: #fff; opacity: .85; }
.cover-text {
  width: 100%;
  min-height: 200px;
  resize: vertical;
  background: var(--paper);
  color: var(--text);
  border: 1px solid var(--grid);
  border-radius: 6px;
  padding: 10px 12px;
  font-family: inherit;
  font-size: 0.82rem;
  line-height: 1.6;
}
.cover-text:focus { outline: none; border-color: var(--accent); }
.cover-hint { font-size: 0.72rem; color: var(--muted); margin-top: 6px; }

/* Full description HTML from hh.ru API */
.vacancy-desc {
  font-size: 0.85rem;
  color: var(--text);
  line-height: 1.7;
}
.vacancy-desc p  { margin-bottom: 10px; }
.vacancy-desc ul,
.vacancy-desc ol { padding-left: 20px; margin-bottom: 10px; }
.vacancy-desc li { margin-bottom: 3px; }
.vacancy-desc strong,
.vacancy-desc b  { color: var(--title); font-weight: 600; }
.vacancy-desc em,
.vacancy-desc i  { color: var(--muted-strong); }

/* Loading / error state */
.m-loading {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
  font-size: 0.82rem;
  padding: 4px 0;
}
.m-loading::before {
  content: '';
  width: 14px; height: 14px;
  border: 2px solid var(--grid);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin .7s linear infinite;
  flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }
.m-error { color: var(--muted); font-size: 0.82rem; }

.modal-foot {
  padding: 16px 24px;
  border-top: 1px solid var(--grid);
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-start;
}
.apply-label { color: var(--muted-strong); font-size: 0.85rem; font-weight: 600; }
.modal-apply-btn {
  background: #54A24B;
  color: #fff;
  border: none;
  padding: 8px 18px;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  transition: opacity .12s;
}
.modal-apply-btn:hover { opacity: .85; }
.modal-apply-btn:disabled { opacity: .5; cursor: default; }
.m-apply-status { font-size: 0.8rem; color: var(--muted-strong); }
.modal-hh-btn {
  background: var(--accent);
  color: #fff;
  text-decoration: none;
  padding: 8px 20px;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 600;
  transition: opacity .12s;
}
.modal-hh-btn:hover { opacity: .85; }
