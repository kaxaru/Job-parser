# ───────── Личное (не коммитить) ─────────
# Резюме, сопроводительные, заметки к собеседованиям. Лежат в personal/ целиком, чтобы
# не разбредаться по корню и не требовать новой строки на каждый файл.
personal/
# Профиль резюме: гражданство, вуз, стаж, факты для ответов рекрутерам. В репо идёт
# обезличенный resume_profile.example.json — его копируют и заполняют локально.
resume_profile.json

# ───────── Внутренние заметки (не для репо) ─────────
# Архив закрытых аудитов и планов рефакторинга — рабочая история, не публичная документация.
docs/history/
# Отчёты аудитов. Кроме «рабочая история, не документация» здесь есть вторая причина:
# в отчёте перечислены НЕЗАКРЫТЫЕ дефекты с готовым сценарием эксплуатации (08.08.2026 —
# CSRF на /api/apply, куки сессии в раздаче статики, XSS в поиске). Публиковать такое
# в открытом репозитории до фиксов нельзя.
docs/audits/
# Шаблоны спеки и RFC — рабочая заготовка, по которой пишется документация, а не сама
# документация. Путь указан целиком: голое `template` совпало бы с любым каталогом этого
# имени в дереве, включая чужие подпроекты.
docs/template/

# ───────── Claude Code ─────────
# Локальные настройки инструмента (allowlist разрешений, подтверждённые на этой машине) —
# машинно-специфичны, не для репо. Общий .claude/settings.json (если появится) — можно коммитить.
.claude/settings.local.json

# ───────── Логи ─────────
# Все логи пишутся ИСКЛЮЧИТЕЛЬНО в logs/ (config.LOGS_DIR + редиректы cron/*.bat).
# Каталог пересоздаётся кодом (LOGS_DIR.mkdir), в репо не нужен.
logs/
*.log

# ───────── Секреты / конфиг ─────────
.env
.env.*
*.env
# ...но шаблон .env-переменных (без реальных значений) — можно коммитить.
!.env.example
# Ключи/токены/креды: даже если появятся под другими именами — не в репо.
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.cookies
cookies.json
hh_state.json
secrets.json
credentials.json
*token*.json
*_token.txt

# ───────── Прокси (реальные — локально; в репо только шаблон proxie.txt) ─────────
# proxy.py читает proxie.txt / proxy.txt; proxie.txt — безопасный шаблон (одни комментарии,
# в репо). proxy.txt и .bak — рабочие файлы с реальными кредами, их не коммитим.
proxie.bak.txt
proxy.txt
proxy.bak.txt

# ───────── Локальные утилиты / отладочные сервисы (не для репо) ─────────
check_proxies.py
peek.py
visualize.py
dbg_search.py

# ───────── Python ─────────
__pycache__/
# кастомный PYTHONPYCACHEPREFIX из бенчей (зеркалит путь ФС) — мусор
.pycache*/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv*/

# ───────── Node / JS (тесты node:test, сборка esbuild) ─────────
# зависимостей нет (node:test встроен), но защищаемся от случайного npm i
node_modules/

# ───────── Сгенерированные данные ─────────
# data/ целиком — состояние и build-артефакты: сырьё парсера, фид (feed*.js/css/html),
# дашборд, отметки, журнал откликов, CSV-отчёты. Каталог пересоздаётся кодом
# (DATA_DIR.mkdir). Логи здесь больше НЕ живут — они в logs/ (см. секцию «Логи»).
data/
# отладочные срезы JSON (peek.py) в корне
pretty.json
pretty_sample.json

# ───────── Временные / бэкапы ─────────
*.bak
*.tmp
*~

# ───────── IDE / OS ─────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
# Недокачанные файлы браузера. 05.08.2026 такой на 26 МБ (видео) утёк в индекс и прожил
# там до аудита 08.08 — каталог проекта совпадает с каталогом загрузок, `git add -A` его и взял.
*.crdownload
*.part
*.download
