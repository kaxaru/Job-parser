# .env.example — шаблон переменных окружения hr_work.
# Скопируйте в .env и заполните своими значениями:  cp .env.example .env   (Windows: copy)
# Сам .env — в .gitignore (не коммитится); этот шаблон — в репозитории.
# Полный список переменных и дефолтов — docs/config.md.

# ─────────── Вход на HH (нужно автоклику, синку статусов, чатам) ───────────
HH_EMAIL=
HH_PASSWORD=
# HH_ACCESS_TOKEN=          # опц.: bearer-токен (напр. для scripts/check_proxies.py)
# HH_CLIENT_ID=             # OAuth-приложение dev.hh.ru — нужно только для `hh.py hhapi --login`
# HH_CLIENT_SECRET=
# HH_REDIRECT_URI=http://localhost:8765/callback
# HH_API_UA=hr-work-applicant/1.0   # User-Agent для api.hh.ru (правила площадки требуют свой)

# ─────────── PostgreSQL (нужен /api/search и подпроекту dwh_demo) ───────────
# Дефолты — под локальный docker compose из dwh_demo (порт 5433, БД/юзер/пароль = hh).
PGHOST=localhost
PGPORT=5433
PGDATABASE=hh
PGUSER=hh
PGPASSWORD=hh

# ─────────── LLM-фичи (opt-in, по умолчанию ВЫКЛЮЧЕНЫ) ───────────
# Без ключа/флага сеть не трогается — движок работает на regex + дословных фактах.
# OPEN_ROUTER_API_KEY=      # ключ OpenRouter (для intent/rephrase/forms)
# INTENT_LLM=1              # LLM-классификатор намерения в чатах
# REPHRASE_LLM=1            # LLM-переформулировка одобренного факта
# FORMS_LLM=1               # LLM-автозаполнение форм-анкет
# ANTHROPIC_API_KEY=        # LLM-сопроводительные письма (hh.py ... --cover llm)
# Тюнинг LLM-вызовов (дефолты ниже; REPHRASE_MODEL/FORM_MODEL пусты -> берут INTENT_MODEL):
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# INTENT_MODEL=deepseek/deepseek-v4-flash
# INTENT_TIMEOUT=6
# REPHRASE_MODEL=           # по умолчанию = INTENT_MODEL
# REPHRASE_TIMEOUT=8
# REPHRASE_MAX_TOKENS=300
# FORM_MODEL=               # по умолчанию = INTENT_MODEL
# FORM_TIMEOUT=8
# FORM_MAX_TOKENS=300
# FORM_MAX_ANSWER_LEN=1500

# ─────────── Источники: какие собирать и как глубоко ───────────
# Закомментированные строки НИЖЕ повторяют дефолты config.py: раскомментировать можно
# любую, ничего при этом не изменив. Держать их в паритете обязательно — 08.08.2026 здесь
# лежал список из семи порталов против девяти в коде, и владелец, раскомментировав строку
# «как есть», молча отключил бы themuse и jobicy.
# SOURCES=hh,hirify,talanto,getmatch,arbeitnow,himalayas,web3,themuse,jobicy
#                           # порядок задаёт победителя при кросс-портальном дедупе
# --- глобальные порталы (не РФ) ---
# WEB3_TOKEN=               # токен web3.career (web3.career/web3-jobs-api, бесплатный, по
#                           # email). Пусто -> источник пропускается: анонимно API
#                           # редиректит на форму регистрации.
# WEB3_TAGS=                # теги для перебора (у API нет пагинации — охват набирается ими)
# WEB3_TAG_CONCURRENCY=6
# ARBEITNOW_MAX_PAGES=120   # страховка; реально ~41 страница по 100. Упор в лимит -> WARNING
#                           # «обход УПЁРСЯ В ЛИМИТ»: значит выдача не исчерпана, надо поднять
# ARBEITNOW_PAGE_CONCURRENCY=6
# HIMALAYAS_MAX_PAGES=5000  # покрывает портал целиком (выдача кончается на ~4870-й странице)
# HIMALAYAS_PAGE_CONCURRENCY=6   # снижено с 12: на ~1900-м запросе портал уходил в троттлинг
# HIMALAYAS_BATCH_PAUSE=0.4      # пауза между пачками, оттуда же
# THEMUSE_MAX_PAGES=99      # ЖЁСТКИЙ потолок портала: страница 100 отдаёт HTTP 400
# THEMUSE_PAGE_CONCURRENCY=6
# THEMUSE_MAX_AGE_DAYS=60   # сортировки по дате у API нет — свежесть режем сами
# THEMUSE_QUERIES=          # комбинации category×level через ';' (у каждой свои 99 страниц)
# JOBICY_COUNT=100          # потолок API, больше игнорирует
# JOBICY_REQUEST_CONCURRENCY=4
# JOBICY_INDUSTRIES=        # индустрии через ','; пустой элемент = запрос без фильтра
# GLOBAL_SOURCES_IT_ONLY=1  # отсев не-IT на входе пяти глобальных (у них 63-66 % не-IT)
# --- порталы РФ ---
# HIRIFY_PARAMS=            # querystring фильтра (skills + специализации)
# HIRIFY_ENRICH_MAX=600     # потолок per-vacancy запросов за прогон
# HIRIFY_PAGE_CONCURRENCY=10
# HIRIFY_ENRICH_CONCURRENCY=8
# TALANTO_PARAMS=limit=100&sort=newest
# TALANTO_ENRICH_MAX=600
# TALANTO_PAGE_CONCURRENCY=8
# TALANTO_ENRICH_CONCURRENCY=8
# GETMATCH_PAGE_SIZE=100
# GETMATCH_PAGE_CONCURRENCY=4
# GETMATCH_ENRICH_CONCURRENCY=4
# GETMATCH_ENRICH_MAX=900

# ─────────── Сбор: сеть и санити-гейт кеша ───────────
# HTTP_BACKEND=curl         # curl | httpx
# CURL_MAX_TIME=25          # таймаут запроса, с
# HH_CONCURRENCY=5          # параллельных запросов к HH
# HH_ENRICH_BATCH_MULT=4    # размер батча дозагрузки = HH_CONCURRENCY * MULT
# COLLECT_MIN_RATIO=0.5     # гейт судит КАЖДЫЙ включённый источник отдельно: портал отдал
#                           # меньше половины своего прошлого объёма -> кеш НЕ перезаписывается
# COLLECT_SANITY_MIN=500    # гейт включается, только если ПРОШЛЫЙ объём портала был не меньше
#                           # этого (у мелкого источника колебания в разы — норма, а не блок)
# DESC_CACHE_MAX_AGE_DAYS=14  # предохранитель от тихой правки описания без смены сигнала
# CACHE_TTL_HOURS=24        # возраст кеша, после которого сбор пересобирает

# ─────────── Отклики ───────────
# HH_DAILY_APPLY_CAP=200    # суточный лимит откликов (лимит площадки)
# APPLY_SKIP_STREAK_MAX=50  # пропусков ПОДРЯД -> прогон останавливается как холостой
# HH_DISABLE_PROXIES=1      # не использовать прокси из proxie.txt

# ─────────── Поиск (/api/search, Postgres) ───────────
# SEARCH_TABLE=search_demo.vacancies
# SEARCH_WORK_MEM=64MB      # work_mem НА СОЕДИНЕНИИ и на пуле. Поднят под count(*) OVER(),
#                           # который буферизовал весь набор; с 08.08.2026 total считается
#                           # отдельным count(*), но все замеры /api/search сняты на 64MB
# SEARCH_POOL_MAX=8         # размер пула подключений

# ─────────── Прочее ───────────
# SERVE_PORT=8000           # порт локального сервера (лента/поиск)
# LOG_BODIES=1              # дословные тела в логе: сообщения чатов и подставленные значения
#                           # анкет. По умолчанию пишется только форма («<N симв.>») — logs/
#                           # не секретный, но персональный сток. Включать на время отладки
